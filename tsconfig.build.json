//  system-chronux-plugin/tsconfig.build.json

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "ES2020"],
    "types": ["node", "react"],
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
  }
}
